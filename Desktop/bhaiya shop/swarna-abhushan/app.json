{
  "expo": {
    "name": "Swarna Abhushan",
    "slug": "swarna-abhushan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "swarna-abhushan",

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.swarnaabhushan.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },

    "ios": {
      "bundleIdentifier": "com.swarnaabhushan.app"
    },

    "plugins": [
      "expo-secure-store",

      [
        "expo-image-picker",
        {
          "photosPermission": "Swarna Abhushan needs access to your photos to upload jewellery images.",
          "mediaLibraryPermission": "Swarna Abhushan needs access to your photos to upload jewellery images."
        }
      ],

      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "expo-asset",
      "expo-notifications"
    ],

    "extra": {
      "eas": {
        "projectId": "96fbb487-c2c7-4612-839f-a349079eec03"
      }
    }
  }
}